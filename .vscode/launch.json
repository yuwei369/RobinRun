{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RobinRun Desktop: Main",
      "type": "pwa-node",
      "request": "attach",
      "port": 9231,
      "preLaunchTask": "robinrun: start electron (debug)",
      "restart": true,
      "timeout": 30000,
      "outFiles": [
        "${workspaceFolder}/packages/desktop/out/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/desktop/out/**/*.js",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal"
    },
    {
      "name": "RobinRun Desktop: Main (with host inspect)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9231,
      "preLaunchTask": "robinrun: start electron (debug with host inspect)",
      "restart": true,
      "timeout": 30000,
      "outFiles": [
        "${workspaceFolder}/packages/desktop/out/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/desktop/out/**/*.js",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "RobinRun Desktop: Renderer",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9229,
      "webRoot": "${workspaceFolder}/packages/desktop/src/renderer",
      "timeout": 30000
    },
    {
      "name": "RobinRun Desktop: Host",
      "type": "pwa-node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "timeout": 30000,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/desktop/out/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/desktop/out/**/*.js",
        "!**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "RobinRun Desktop: F5",
      "configurations": [
        "RobinRun Desktop: Main",
        "RobinRun Desktop: Renderer"
      ],
      "stopAll": true
    },
    {
      "name": "RobinRun Desktop: F5 (with host inspect)",
      "configurations": [
        "RobinRun Desktop: Main (with host inspect)",
        "RobinRun Desktop: Renderer",
        "RobinRun Desktop: Host"
      ],
      "stopAll": true
    }
  ]
}
