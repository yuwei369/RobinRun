{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.turbo/**"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:desktop-agent": {
      "dependsOn": [
        "@robinrun/shared-types#build",
        "@robinrun/contracts#build",
        "@robinrun/dynamic-workflow#build",
        "@robinrun/core#build",
        "@robinrun/adapters#build",
        "@robinrun/bootstrap#build",
        "@robinrun/i18n#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/../../packages/shared/package.json",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/robinrun-builtin.json",
        "$TURBO_ROOT$/../../config/provider/robinrun-builtin.test.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/robinrun-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["ROBINRUN_ENV", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["**"],
      "env": ["ROBINRUN_CUA_REPO", "VITEST_MAX_WORKERS"],
      "outputs": []
    },
    "coverage": {
      "dependsOn": ["build"],
      "inputs": ["**"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "lint:fix": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@robinrun/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/robinrun-builtin.json",
        "$TURBO_ROOT$/../../config/provider/robinrun-builtin.test.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/robinrun-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["ROBINRUN_ENV", "NODE_ENV"]
    }
  }
}
